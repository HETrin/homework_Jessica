import java.util.Scanner;

public class MarkAnalyzer {
    public static void main(String[] args) {
        Scanner scan = new Scanner(System.in);
        int count = 0;
        int sum = 0;
        int max = -1;
        
        int value = scan.nextInt();
        while (value != -1) {
            count++;
            sum = sum + value;
            
            if (value > max) {
                max = value;
            }
            
            value = scan.nextInt();
        }
        
        System.out.println("Count: " + count);
        System.out.println("Sum: " + sum);
        
        if (count > 0) {
            double avg = (double) sum / count;
            System.out.println("Average: " + avg);
            System.out.println("Largest: " + max);
        } else {
            System.out.println("No valid values.");
        }
    }
}

(b)
We must read the first value before the loop because the while condition needs it. If we only read inside the loop, the value is not ready before the check. This causes an error. Reading it first lets the user enter -1 right away to skip the loop.
